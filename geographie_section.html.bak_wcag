<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/svg+xml" href="images/favicon.svg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Géographie - Le Monde des Curieux</title>
    <link rel="stylesheet" href="styles/geographie_CSS.css">
    <link rel="stylesheet" href="styles/wcag-accessibility.css">
</head>

<body x-data="geographieApp" x-cloak>

    <a class="skip-link" href="#main-content">Aller au contenu principal</a>

    <!-- Scripts section -->
    <script src="scripts/section-xp-system.js"></script>
    <script src="scripts/data/geographie-lessons.js"></script>

    <!-- Bulle Curio -->
    <div x-data="curioBubble" x-show="visible" x-transition :class="'curio-bubble ' + variant">
        <button @click="hide()" class="curio-close" aria-label="Fermer">×</button>
        <div class="curio-avatar">🦊</div>
        <p class="curio-message" x-text="currentMessage"></p>
    </div>

    <div class="geographie-container" id="main-content">

        <!-- Header -->
        <div class="section-header">
            <button onclick="window.location.href='index.html'" class="back-btn">
                ← Retour à l'accueil
            </button>
        </div>

        <!-- Titre -->
        <div class="section-title">
            <h1>🗺️ Géographie</h1>
            <p>Explore la France, l'Europe et le monde !</p>
        </div>

        <!-- Navigation thèmes -->
        <nav class="themes-nav" role="navigation" aria-label="Thèmes de géographie">
            <button @click="selectTheme('france')"
                :class="'theme-btn theme-france' + (currentTheme === 'france' ? ' active' : '')">
                🇫🇷 La France
            </button>
            <button @click="selectTheme('europe')"
                :class="'theme-btn theme-europe' + (currentTheme === 'europe' ? ' active' : '')">
                🇪🇺 L'Europe
            </button>
            <button @click="selectTheme('deplacements')"
                :class="'theme-btn theme-deplacements' + (currentTheme === 'deplacements' ? ' active' : '')">
                🚆 Déplacements & Mobilités
            </button>
        </nav>

        <!-- Contenu thème -->
        <div class="theme-content">

            <div class="theme-section">
                <h2 x-text="getThemeTitle()"></h2>
                <p class="theme-subtitle" x-text="getThemeSubtitle()"></p>
            </div>

            <!-- Boutons d'action -->
            <div class="action-buttons">

                <!-- Ligne 1 : navigation principale -->
                <div class="action-row action-row-nav">
                    <button @click="toggleIllustration()" class="action-btn btn-primary"
                        aria-label="Voir l'illustration">
                        🖼️ Voir l'illustration
                    </button>
                    <button @click="toggleLesson()" class="action-btn btn-info"
                        aria-label="En savoir plus">
                        📖 En savoir plus
                    </button>
                </div>

                <!-- Ligne 2 : leçons dédiées France -->
                <div class="action-row action-row-lessons" x-show="currentTheme === 'france'">
                    <span class="action-row-label">📚 Leçons dédiées</span>
                    <div class="action-lesson-pairs">
                        <div class="lesson-pair">
                            <button @click="currentLesson = 'relief'; showLesson = true"
                                class="action-btn btn-lesson">
                                ⛰️ Relief & Fleuves
                            </button>
                            <button @click="currentLesson = 'relief'; showIllustration = true"
                                class="action-btn btn-primary">
                                🖼️ Carte topo
                            </button>
                            <button @click="startQuizForLesson('relief')"
                                class="action-btn btn-quiz">
                                📝 Quiz
                            </button>
                        </div>
                        <div class="lesson-pair">
                            <button @click="currentLesson = 'regions'; showLesson = true"
                                class="action-btn btn-lesson">
                                🗺️ Régions
                            </button>
                            <button @click="startQuizForLesson('regions')"
                                class="action-btn btn-quiz">
                                📝 Quiz
                            </button>
                        </div>
                        <div class="lesson-pair">
                            <button @click="currentLesson = 'villes'; showLesson = true"
                                class="action-btn btn-lesson">
                                🏙️ Grandes Villes
                            </button>
                            <button @click="startQuizForLesson('villes')"
                                class="action-btn btn-quiz">
                                📝 Quiz
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Ligne 2 : leçons dédiées Europe -->
                <div class="action-row action-row-lessons" x-show="currentTheme === 'europe'">
                    <span class="action-row-label">📚 Leçons dédiées</span>
                    <div class="action-lesson-pairs">
                        <div class="lesson-pair">
                            <button @click="currentLesson = 'pays_europe'; showLesson = true"
                                class="action-btn btn-lesson">
                                🗺️ Pays & Capitales
                            </button>
                            <button @click="startQuizForLesson('pays_europe')"
                                class="action-btn btn-quiz">
                                📝 Quiz
                            </button>
                        </div>
                        <div class="lesson-pair">
                            <button @click="currentLesson = 'ue'; showLesson = true"
                                class="action-btn btn-lesson">
                                🇪🇺 Union Européenne
                            </button>
                            <button @click="startQuizForLesson('ue')"
                                class="action-btn btn-quiz">
                                📝 Quiz
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Ligne 2 : leçons dédiées Déplacements -->
                <div class="action-row action-row-lessons" x-show="currentTheme === 'deplacements'">
                    <span class="action-row-label">📚 Leçons dédiées</span>
                    <div class="action-lesson-pairs">
                        <div class="lesson-pair">
                            <button @click="currentLesson = 'transports'; showLesson = true"
                                class="action-btn btn-lesson">
                                🚌 Transports en France
                            </button>
                            <button @click="startQuizForLesson('transports')"
                                class="action-btn btn-quiz">
                                📝 Quiz
                            </button>
                        </div>
                        <div class="lesson-pair">
                            <button @click="currentLesson = 'monde'; showLesson = true"
                                class="action-btn btn-lesson">
                                🌍 Mobilités mondiales
                            </button>
                            <button @click="startQuizForLesson('monde')"
                                class="action-btn btn-quiz">
                                📝 Quiz
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Ligne 3 : quiz du thème -->
                <div class="action-row action-row-period-quiz">
                    <button @click="startQuiz()" class="action-btn btn-quiz"
                        aria-label="Démarrer le quiz du thème">
                        🎯 Quiz du thème
                    </button>
                </div>

            </div>

            <!-- EN SAVOIR PLUS -->
            <div x-show="showLesson" x-transition class="lesson-container">
                <div class="lesson-header">
                    <h2>📖 <span x-text="getLessonTitle()"></span></h2>
                    <button @click="showLesson = false" class="close-btn" aria-label="Fermer la leçon">
                        Fermer
                    </button>
                </div>
                <div class="lesson-content" x-html="getLessonContent()"></div>
            </div>

            <!-- ILLUSTRATION -->
            <div x-show="showIllustration" x-transition class="map-container">
                <div class="map-header">
                    <h2>🖼️ <span x-text="getIllustrationTitle()"></span></h2>
                    <button @click="showIllustration = false" class="close-btn"
                        aria-label="Fermer l'illustration">
                        Fermer
                    </button>
                </div>
                <div class="map-content">
                    <img :src="getIllustrationUrl()"
                         :alt="getIllustrationTitle()"
                         loading="lazy"
                         class="map-image">
                </div>
            </div>

        </div>

        <!-- QUIZ -->
        <div x-show="showQuiz" x-transition class="quiz-container">
            <div class="quiz-header">
                <h2>🎯 Quiz — <span x-text="currentLesson ? getLessonTitle() : getThemeTitle()"></span></h2>
                <div class="quiz-progress">
                    <p>Question <span x-text="currentQuestion + 1"></span> /
                        <span x-text="getCurrentQuiz().length"></span>
                    </p>
                    <div class="progress-bar" role="progressbar"
                        :aria-valuenow="currentQuestion + 1"
                        :aria-valuemax="getCurrentQuiz().length"
                        aria-valuemin="0"
                        aria-label="Progression du quiz">
                        <div class="progress-fill"
                            :style="'width: ' + ((currentQuestion + 1) / getCurrentQuiz().length * 100) + '%'">
                        </div>
                    </div>
                </div>
            </div>

            <div class="quiz-content" aria-live="polite">
                <p class="question" x-text="getCurrentQuestionData().question"></p>
                <div class="options">
                    <template x-for="(option, index) in getCurrentQuestionData().options" :key="index">
                        <button @click="selectAnswer(index)"
                            :class="'option-btn ' + getOptionClass(index)"
                            :disabled="answerChecked"
                            :aria-pressed="selectedAnswer === index">
                            <span x-text="option"></span>
                        </button>
                    </template>
                </div>
            </div>
        </div>

        <!-- RÉSULTATS -->
        <div x-show="showResults" x-transition class="results-container"
            aria-live="polite" aria-atomic="true">
            <div class="results-content">
                <h2>🎉 Quiz terminé !</h2>
                <div class="score-display">
                    <div class="score-circle">
                        <div class="score-value" x-text="score"></div>
                        <div class="score-total" x-text="'/ ' + getCurrentQuiz().length"></div>
                    </div>
                    <p class="score-percentage"
                        x-text="Math.round((score / getCurrentQuiz().length) * 100) + '%'">
                    </p>
                    <p class="score-message" x-text="getScoreMessage()"></p>
                </div>
                <div class="results-actions">
                    <button @click="retryQuiz()" class="btn-retry">🔄 Recommencer</button>
                    <button @click="backToTheme()" class="btn-back">← Retour au thème</button>
                </div>
            </div>
        </div>

    </div>

    <!-- Annonceur screen reader -->
    <div class="sr-announce" aria-live="assertive" aria-atomic="true" id="sr-announcer"></div>

    <!-- Alpine.js CDN -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <script>
        document.addEventListener('alpine:init', () => {

            Alpine.data('curioBubble', () => ({
                visible: false,
                currentMessage: '',
                variant: 'info',
                autoHideTimer: null,
                init() { window.curioBubbleInstance = this; },
                show(m, v = 'info') {
                    if (this.autoHideTimer) clearTimeout(this.autoHideTimer);
                    this.currentMessage = m;
                    this.variant = v;
                    this.visible = true;
                    this.autoHideTimer = setTimeout(() => this.hide(), 5000);
                },
                hide() { this.visible = false; }
            }));

            Alpine.data('geographieApp', () => ({
                currentTheme: 'france',
                currentLesson: null,
                showLesson: false,
                showIllustration: false,
                showQuiz: false,
                showResults: false,
                currentQuestion: 0,
                score: 0,
                selectedAnswer: null,
                answerChecked: false,
                audioContext: null,

                init() {
                    this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
                    if (window.SectionXP) window.SectionXP.init('geographie');
                },

                playCorrectSound() {
                    try {
                        const o = this.audioContext.createOscillator();
                        const g = this.audioContext.createGain();
                        o.connect(g);
                        g.connect(this.audioContext.destination);
                        o.frequency.value = 523;
                        o.type = 'sine';
                        g.gain.setValueAtTime(0.3, this.audioContext.currentTime);
                        g.gain.exponentialRampToValueAtTime(0.01, this.audioContext.currentTime + 0.2);
                        o.start();
                        o.stop(this.audioContext.currentTime + 0.2);
                    } catch(e) {}
                },

                playIncorrectSound() {
                    try {
                        const o = this.audioContext.createOscillator();
                        const g = this.audioContext.createGain();
                        o.connect(g);
                        g.connect(this.audioContext.destination);
                        o.frequency.value = 185;
                        o.type = 'triangle';
                        g.gain.setValueAtTime(0.3, this.audioContext.currentTime);
                        g.gain.exponentialRampToValueAtTime(0.01, this.audioContext.currentTime + 0.3);
                        o.start();
                        o.stop(this.audioContext.currentTime + 0.3);
                    } catch(e) {}
                },

                quizData: {
                    france: [
                        { question: "Quelle est la superficie approximative de la France métropolitaine ?", options: ["550 000 km²", "643 801 km²", "750 000 km²", "450 000 km²"], correct: 1 },
                        { question: "Quelle est la plus haute montagne de France ?", options: ["Le Mont Blanc", "Le Mont-Dore", "Le Puy de Dôme", "Le Vercors"], correct: 0 },
                        { question: "Quel est le plus long fleuve de France ?", options: ["La Seine", "Le Rhône", "La Loire", "La Garonne"], correct: 2 },
                        { question: "Combien de régions compte la France métropolitaine depuis 2016 ?", options: ["13", "22", "18", "10"], correct: 0 },
                        { question: "Quelle mer borde la côte sud-est de la France ?", options: ["L'Atlantique", "La Méditerranée", "La Manche", "La mer du Nord"], correct: 1 },
                        { question: "Quel pays partage la frontière nord-est de la France ?", options: ["Belgique, Luxembourg, Allemagne", "Espagne, Italie, Suisse", "Angleterre, Belgique, Pays-Bas", "Allemagne, Autriche, Suisse"], correct: 0 },
                        { question: "Quelle chaîne de montagnes sépare la France de l'Espagne ?", options: ["Les Alpes", "Les Vosges", "Les Pyrénées", "Le Massif Central"], correct: 2 },
                        { question: "Quelle est la capitale de la France ?", options: ["Lyon", "Marseille", "Paris", "Bordeaux"], correct: 2 },
                        { question: "Combien de départements compte la France métropolitaine ?", options: ["75", "96", "101", "89"], correct: 1 },
                        { question: "Quel fleuve traverse Paris ?", options: ["La Loire", "Le Rhône", "La Garonne", "La Seine"], correct: 3 }
                    ],
                    europe: [
                        { question: "Combien de pays composent l'Union Européenne ?", options: ["25", "27", "30", "32"], correct: 1 },
                        { question: "Quelle est la capitale de l'Allemagne ?", options: ["Munich", "Hambourg", "Berlin", "Francfort"], correct: 2 },
                        { question: "Quelle est la monnaie de la zone euro ?", options: ["Le franc", "La livre", "Le mark", "L'euro"], correct: 3 },
                        { question: "Quel pays a quitté l'Union Européenne en 2020 ?", options: ["La Suède", "La Suisse", "Le Royaume-Uni", "La Norvège"], correct: 2 },
                        { question: "Quelle est la capitale de l'Italie ?", options: ["Milan", "Rome", "Naples", "Turin"], correct: 1 },
                        { question: "Quelle est la plus haute montagne d'Europe ?", options: ["Le Mont Blanc", "L'Elbrouz", "Le Cervin", "Les Dolomites"], correct: 1 },
                        { question: "Quelle est la capitale de l'Espagne ?", options: ["Barcelone", "Séville", "Madrid", "Valence"], correct: 2 },
                        { question: "Quel fleuve traverse plusieurs pays d'Europe centrale ?", options: ["Le Rhin", "Le Danube", "La Volga", "L'Elbe"], correct: 1 },
                        { question: "Quelle est la capitale de la Belgique ?", options: ["Bruges", "Anvers", "Bruxelles", "Gand"], correct: 2 },
                        { question: "Quel symbole représente l'Union Européenne ?", options: ["Un drapeau bleu aux 12 étoiles", "Un drapeau rouge à l'étoile", "Un drapeau vert", "Un drapeau rayé"], correct: 0 }
                    ],
                    deplacements: [
                        { question: "Comment appelle-t-on le train très rapide français ?", options: ["TER", "Intercités", "TGV", "RER"], correct: 2 },
                        { question: "Quelle ville française a le plus grand aéroport ?", options: ["Lyon", "Paris (CDG)", "Marseille", "Nice"], correct: 1 },
                        { question: "Quel canal relie la mer du Nord à la Méditerranée ?", options: ["Canal de Suez", "Canal du Midi", "Canal de Panama", "Canal du Rhône au Rhin"], correct: 1 },
                        { question: "Par quel tunnel passe-t-on sous la Manche ?", options: ["Le tunnel du Mont-Blanc", "L'Eurotunnel", "Le tunnel du Fréjus", "Le tunnel sous la Moselle"], correct: 1 },
                        { question: "Comment s'appelle le déplacement entre son domicile et son travail ?", options: ["Migration", "Pendulaire ou navette", "Transit", "Exode"], correct: 1 },
                        { question: "Quel transport est considéré comme le plus écologique ?", options: ["La voiture", "L'avion", "Le train", "Le bateau"], correct: 2 },
                        { question: "Comment appelle-t-on les personnes qui quittent leur pays définitivement ?", options: ["Touristes", "Pendulaires", "Emigrants", "Frontaliers"], correct: 2 },
                        { question: "Quelle ville française est un grand port sur la Méditerranée ?", options: ["Bordeaux", "Marseille", "Nantes", "Rouen"], correct: 1 },
                        { question: "Comment appelle-t-on un réseau de routes rapides sans péage ?", options: ["Autoroute", "Voie rapide", "Bretelle", "Rocade"], correct: 1 },
                        { question: "Quel continent envoie le plus de migrants vers l'Europe ?", options: ["Asie", "Amérique", "Afrique", "Océanie"], correct: 2 }
                    ],
                    relief: [
                        { question: "Quel massif montagneux se trouve à l'est de la France ?", options: ["Les Pyrénées", "Les Alpes", "Les Vosges", "Le Jura"], correct: 1 },
                        { question: "Quelle est la hauteur du Mont Blanc ?", options: ["4 000 m", "4 400 m", "4 808 m", "5 000 m"], correct: 2 },
                        { question: "Dans quel département se trouve le Mont Blanc ?", options: ["Isère", "Savoie", "Haute-Savoie", "Hautes-Alpes"], correct: 2 },
                        { question: "Quel fleuve se jette dans l'Atlantique à Bordeaux ?", options: ["La Loire", "La Garonne", "La Dordogne", "La Charente"], correct: 1 },
                        { question: "Quel massif central culmine avec le Puy de Sancy ?", options: ["Les Vosges", "Les Cévennes", "Le Massif Central", "L'Ardèche"], correct: 2 },
                        { question: "Quel fleuve traverse Lyon ?", options: ["La Loire", "La Seine", "Le Rhône", "L'Isère"], correct: 2 },
                        { question: "Quelle montagne volcanique se trouve en Auvergne ?", options: ["La Chartreuse", "Le Puy de Dôme", "Le Ballon d'Alsace", "Le Canigou"], correct: 1 },
                        { question: "Quel fleuve marque la frontière entre la France et l'Allemagne ?", options: ["La Moselle", "La Meuse", "Le Rhin", "La Sarre"], correct: 2 },
                        { question: "Quelle région française possède les plages du Débarquement ?", options: ["Bretagne", "Normandie", "Picardie", "Pays de la Loire"], correct: 1 },
                        { question: "Comment s'appelle la chaîne de montagnes entre France et Allemagne ?", options: ["Le Jura", "Les Vosges", "Les Ardennes", "Les Alpes"], correct: 1 }
                    ],
                    regions: [
                        { question: "Quelle est la plus grande région de France métropolitaine ?", options: ["Île-de-France", "Nouvelle-Aquitaine", "Occitanie", "Auvergne-Rhône-Alpes"], correct: 1 },
                        { question: "Dans quelle région se trouve Paris ?", options: ["Centre-Val de Loire", "Île-de-France", "Hauts-de-France", "Normandie"], correct: 1 },
                        { question: "Quelle région se trouve au nord de la France ?", options: ["Normandie", "Bretagne", "Hauts-de-France", "Grand Est"], correct: 2 },
                        { question: "De quelle région Bordeaux est-il le chef-lieu ?", options: ["Occitanie", "Bretagne", "Pays de la Loire", "Nouvelle-Aquitaine"], correct: 3 },
                        { question: "Quelle région englobe Strasbourg ?", options: ["Bourgogne-Franche-Comté", "Grand Est", "Hauts-de-France", "Auvergne-Rhône-Alpes"], correct: 1 },
                        { question: "Dans quelle région se trouve Marseille ?", options: ["Occitanie", "Corse", "PACA", "Auvergne-Rhône-Alpes"], correct: 2 },
                        { question: "Quelle région est surnommée 'le jardin de la France' ?", options: ["Bretagne", "Normandie", "Centre-Val de Loire", "Bourgogne"], correct: 2 },
                        { question: "Où se trouve la région Bretagne ?", options: ["Nord-est", "Sud-est", "Nord-ouest", "Sud-ouest"], correct: 2 },
                        { question: "Quelle île française est une région à part entière ?", options: ["Réunion", "Corse", "Guadeloupe", "Martinique"], correct: 1 },
                        { question: "Dans quelle région se trouve Lyon ?", options: ["PACA", "Bourgogne-Franche-Comté", "Auvergne-Rhône-Alpes", "Occitanie"], correct: 2 }
                    ],
                    villes: [
                        { question: "Quelle est la ville la plus peuplée de France ?", options: ["Marseille", "Lyon", "Paris", "Toulouse"], correct: 2 },
                        { question: "Quelle ville est surnommée 'la ville rose' ?", options: ["Bordeaux", "Toulouse", "Montpellier", "Nice"], correct: 1 },
                        { question: "Quelle ville française est la deuxième plus grande ?", options: ["Lyon", "Marseille", "Bordeaux", "Lille"], correct: 1 },
                        { question: "Quel port est le plus grand de France ?", options: ["Bordeaux", "Nantes", "Marseille", "Le Havre"], correct: 3 },
                        { question: "Dans quelle ville se trouve le siège du Parlement européen ?", options: ["Bruxelles", "Luxembourg", "Strasbourg", "Paris"], correct: 2 },
                        { question: "Quelle ville est la capitale de la région Bretagne ?", options: ["Brest", "Nantes", "Rennes", "Quimper"], correct: 2 },
                        { question: "Quelle ville française est connue pour ses vins ?", options: ["Bordeaux", "Lyon", "Grenoble", "Montpellier"], correct: 0 },
                        { question: "Quelle ville se trouve à l'embouchure du Rhône ?", options: ["Marseille", "Toulon", "Nice", "Arles"], correct: 3 },
                        { question: "Quelle ville est la porte d'entrée vers l'Alsace ?", options: ["Metz", "Nancy", "Strasbourg", "Mulhouse"], correct: 2 },
                        { question: "Quelle ville française est célèbre pour son festival de cinéma ?", options: ["Nice", "Cannes", "Monaco", "Antibes"], correct: 1 }
                    ],
                    pays_europe: [
                        { question: "Quelle est la capitale du Portugal ?", options: ["Porto", "Lisbonne", "Braga", "Coimbra"], correct: 1 },
                        { question: "Quelle est la capitale de la Pologne ?", options: ["Cracovie", "Lodz", "Varsovie", "Gdansk"], correct: 2 },
                        { question: "Quel pays a pour capitale Amsterdam ?", options: ["Belgique", "Danemark", "Suède", "Pays-Bas"], correct: 3 },
                        { question: "Quelle est la capitale de la Grèce ?", options: ["Thessalonique", "Athènes", "Héraklion", "Patras"], correct: 1 },
                        { question: "Quel est le plus petit pays du monde, enclavé en Italie ?", options: ["Monaco", "Liechtenstein", "Saint-Marin", "Vatican"], correct: 3 },
                        { question: "Quelle est la capitale de la Suède ?", options: ["Oslo", "Copenhague", "Stockholm", "Helsinki"], correct: 2 },
                        { question: "Quel pays partage des frontières avec 8 autres pays ?", options: ["France", "Pologne", "Allemagne", "Autriche"], correct: 2 },
                        { question: "Quelle est la capitale de l'Autriche ?", options: ["Graz", "Vienne", "Salzbourg", "Innsbruck"], correct: 1 },
                        { question: "Quelle est la capitale du Danemark ?", options: ["Oslo", "Stockholm", "Copenhague", "Helsinki"], correct: 2 },
                        { question: "Quelle mer sépare l'Espagne de l'Afrique ?", options: ["Atlantique", "Méditerranée", "Manche", "Détroit de Gibraltar"], correct: 1 }
                    ],
                    ue: [
                        { question: "En quelle année l'Union Européenne a-t-elle été créée (Traité de Maastricht) ?", options: ["1957", "1968", "1992", "2004"], correct: 2 },
                        { question: "Quel traité de 1957 fonde la Communauté Économique Européenne ?", options: ["Traité de Paris", "Traité de Rome", "Traité de Maastricht", "Traité de Lisbonne"], correct: 1 },
                        { question: "Combien de pays utilisent l'euro ?", options: ["15", "20", "27", "30"], correct: 1 },
                        { question: "Où siège le Parlement Européen ?", options: ["Bruxelles et Paris", "Strasbourg et Bruxelles", "Genève et Bruxelles", "Luxembourg et Paris"], correct: 1 },
                        { question: "Quel est le symbole de l'Union Européenne ?", options: ["12 étoiles sur fond bleu", "Un aigle doré", "Une carte d'Europe", "Un anneau de 27 étoiles"], correct: 0 },
                        { question: "Quelle valeur fondamentale l'UE défend-elle pour les citoyens ?", options: ["Liberté de circulation", "Monnaie unique obligatoire", "Langue commune", "Religion officielle"], correct: 0 },
                        { question: "Quel pays est le plus peuplé de l'Union Européenne ?", options: ["France", "Italie", "Espagne", "Allemagne"], correct: 3 },
                        { question: "Quand la France est-elle passée à l'euro pour les billets ?", options: ["1999", "2000", "2002", "2004"], correct: 2 },
                        { question: "Quel est le rôle de la Banque Centrale Européenne ?", options: ["Financer les guerres", "Gérer la monnaie unique", "Élire le président", "Contrôler les frontières"], correct: 1 },
                        { question: "Où est situé le siège officiel de l'Union Européenne ?", options: ["Paris", "Genève", "Bruxelles", "Strasbourg"], correct: 2 }
                    ],
                    transports: [
                        { question: "Quelle ville française a le métro le plus ancien ?", options: ["Lyon", "Marseille", "Paris", "Lille"], correct: 2 },
                        { question: "En quelle année le premier TGV Paris-Lyon est-il inauguré ?", options: ["1975", "1981", "1990", "1985"], correct: 1 },
                        { question: "Combien de kilomètres d'autoroutes la France possède-t-elle environ ?", options: ["5 000 km", "12 000 km", "20 000 km", "30 000 km"], correct: 1 },
                        { question: "Quel est le plus grand aéroport de France ?", options: ["Orly", "CDG Roissy", "Lyon Saint-Exupéry", "Nice"], correct: 1 },
                        { question: "Comment s'appelle le train régional moins rapide que le TGV ?", options: ["RER", "TER", "Intercités", "Metro"], correct: 1 },
                        { question: "Quel tunnel ferroviaire relie la France au Royaume-Uni ?", options: ["Tunnel du Fréjus", "Tunnel du Mont-Blanc", "Eurotunnel sous la Manche", "Tunnel du Simplon"], correct: 2 },
                        { question: "Quel grand port atlantique est proche de Bordeaux ?", options: ["La Rochelle", "Bayonne", "Rochefort", "Le Verdon"], correct: 3 },
                        { question: "Quelle ville est le hub ferroviaire du nord de la France ?", options: ["Amiens", "Calais", "Lille", "Rouen"], correct: 2 },
                        { question: "Quel canal relie Bordeaux à la Méditerranée ?", options: ["Canal du Midi", "Canal de Bourgogne", "Canal du Rhône", "Canal de Briare"], correct: 0 },
                        { question: "Quelle compagnie nationale gère les trains en France ?", options: ["Air France", "RATP", "SNCF", "Transdev"], correct: 2 }
                    ],
                    monde: [
                        { question: "Combien de continents compte la Terre ?", options: ["5", "6", "7", "8"], correct: 2 },
                        { question: "Quelle est la population mondiale approximative ?", options: ["5 milliards", "7 milliards", "8 milliards", "10 milliards"], correct: 2 },
                        { question: "Quel continent est le plus peuplé ?", options: ["Afrique", "Asie", "Europe", "Amérique"], correct: 1 },
                        { question: "Comment s'appelle le déplacement de populations vers les villes ?", options: ["Exode rural", "Migration climatique", "Nomadisme", "Transhumance"], correct: 0 },
                        { question: "Quel océan est le plus grand du monde ?", options: ["Atlantique", "Indien", "Arctique", "Pacifique"], correct: 3 },
                        { question: "Comment appelle-t-on les personnes forcées de quitter leur pays ?", options: ["Touristes", "Migrants économiques", "Réfugiés", "Expatriés"], correct: 2 },
                        { question: "Quelle région du monde est la plus urbanisée ?", options: ["Afrique", "Europe et Amérique du Nord", "Asie", "Océanie"], correct: 1 },
                        { question: "Quel détroit sépare l'Europe de l'Afrique ?", options: ["Détroit de Magellan", "Détroit de Gibraltar", "Détroit de Bering", "Détroit de Malacca"], correct: 1 },
                        { question: "Combien de fuseaux horaires y a-t-il dans le monde ?", options: ["12", "18", "24", "36"], correct: 2 },
                        { question: "Quel pays est à la fois en Europe et en Asie ?", options: ["Russie", "Turquie", "Kazakhstan", "Les trois"], correct: 3 }
                    ]
                },

                illustrationData: {
                    france:      { title: "Carte physique de France",      url: "images/geographie/carte_france_physique.svg" },
                    europe:      { title: "Carte de l'Europe",             url: "images/geographie/carte_europe_colored.svg" },
                    deplacements:{ title: "Carte topographique & fleuves", url: "images/geographie/carte_france.jpg" }
                },

                selectTheme(t) {
                    this.currentTheme = t;
                    this.currentLesson = null;
                    this.showQuiz = false;
                    this.showResults = false;
                    this.showLesson = false;
                    this.showIllustration = false;
                },

                toggleLesson() {
                    this.currentLesson = null;
                    this.showLesson = !this.showLesson;
                },

                toggleIllustration() {
                    this.showIllustration = !this.showIllustration;
                },

                startQuiz() {
                    this.showQuiz = true;
                    this.showResults = false;
                    this.currentQuestion = 0;
                    this.score = 0;
                    this.selectedAnswer = null;
                    this.answerChecked = false;
                },

                startQuizForLesson(key) {
                    this.currentLesson = key;
                    this.startQuiz();
                },

                getCurrentQuiz() {
                    return this.quizData[this.currentLesson || this.currentTheme] || [];
                },

                getCurrentQuestionData() {
                    return this.getCurrentQuiz()[this.currentQuestion] || {};
                },

                selectAnswer(idx) {
                    if (this.answerChecked) return;
                    this.selectedAnswer = idx;
                    const q = this.getCurrentQuestionData();
                    this.answerChecked = true;
                    if (idx === q.correct) {
                        this.score++;
                        this.playCorrectSound();
                        if (window.SectionXP) window.SectionXP.addXP('geographie', window.SectionXP.rewards.QUESTION_CORRECT);
                    } else {
                        this.playIncorrectSound();
                    }
                    setTimeout(() => {
                        if (this.currentQuestion < this.getCurrentQuiz().length - 1) {
                            this.nextQuestion();
                        } else {
                            this.finishQuiz();
                        }
                    }, 2000);
                },

                nextQuestion() {
                    this.currentQuestion++;
                    this.selectedAnswer = null;
                    this.answerChecked = false;
                },

                getOptionClass(idx) {
                    if (!this.answerChecked) return this.selectedAnswer === idx ? 'selected' : '';
                    const q = this.getCurrentQuestionData();
                    if (idx === q.correct) return 'correct';
                    if (idx === this.selectedAnswer) return 'incorrect';
                    return '';
                },

                finishQuiz() {
                    this.showQuiz = false;
                    this.showResults = true;
                    if (window.SectionXP) {
                        window.SectionXP.addXP('geographie', window.SectionXP.rewards.QUIZ_COMPLETED);
                        if (this.score === this.getCurrentQuiz().length) {
                            window.SectionXP.addXP('geographie', window.SectionXP.rewards.PERFECT_QUIZ);
                        }
                    }
                },

                retryQuiz() {
                    this.showResults = false;
                    this.showQuiz = true;
                    this.currentQuestion = 0;
                    this.score = 0;
                    this.selectedAnswer = null;
                    this.answerChecked = false;
                },

                backToTheme() {
                    this.showResults = false;
                    this.showQuiz = false;
                },

                getThemeTitle() {
                    const titles = {
                        france:       'La France dans le monde',
                        europe:       'L\'Europe',
                        deplacements: 'Déplacements & Mobilités'
                    };
                    return titles[this.currentTheme] || '';
                },

                getThemeSubtitle() {
                    const subtitles = {
                        france:       'Relief, fleuves, régions et grandes villes',
                        europe:       'Pays, capitales et Union Européenne',
                        deplacements: 'Transports, migrations et connexions mondiales'
                    };
                    return subtitles[this.currentTheme] || '';
                },

                getLessonTitle() {
                    const key = this.currentLesson || this.currentTheme;
                    return (window.geographieLeconData || {})[key]?.title || 'En savoir plus';
                },

                getLessonContent() {
                    const key = this.currentLesson || this.currentTheme;
                    return (window.geographieLeconData || {})[key]?.content || '<p>Contenu en cours de rédaction...</p>';
                },

                getIllustrationTitle() {
                    if (this.currentLesson === 'relief')
                        return 'Carte topographique & fleuves';
                    return this.illustrationData[this.currentTheme]?.title || '';
                },

                getIllustrationUrl() {
                    if (this.currentLesson === 'relief')
                        return 'images/geographie/carte_france.jpg';
                    return this.illustrationData[this.currentTheme]?.url || '';
                },

                getScoreMessage() {
                    const pct = (this.score / this.getCurrentQuiz().length) * 100;
                    if (pct === 100) return '🏆 Parfait ! Tu es un expert en géographie !';
                    if (pct >= 80)  return '🌟 Excellent ! Très bien joué !';
                    if (pct >= 60)  return '👍 Bien ! Continue comme ça !';
                    if (pct >= 40)  return '💪 Pas mal ! Révise encore un peu !';
                    return '📚 Continue à apprendre, tu vas y arriver !';
                }

            }));
        });
    </script>

    <script src="scripts/admin-shortcut.js"></script>
    <script src="scripts/master-game-system.js"></script>
    <script>
        window.addEventListener('load', () => {
            setTimeout(() => {
                if (typeof MasterGameSystem !== 'undefined') {
                    window.gameSystem = new MasterGameSystem();
                }
            }, 200);
        });
    </script>

</body>
</html>
